<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Conversation Story — <%= title %></title>
<!-- Fonts via CDN for now; self-hosting into assets/fonts/ is a TODO (see notes/plan.md). -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cascadia+Code:wght@400;600&family=Tenor+Sans&family=Sen:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="../assets/story.css">
</head>
<body data-story="<%= title %>"><%# data-story: the editing UI PUTs summaries back under this name %>

<header class="site">
  <img class="logo" src="../images/logo.png" alt="Graceful Developer logo">
  <div class="titles">
    <h1 class="deco">Conversation Story</h1>
    <span class="subtitle"><%= subtitle %></span>
  </div>
  <div class="meta">
    <div class="stat"><span class="k">Events</span><span class="v"><%= events_stat %></span></div>
    <div class="stat"><span class="k">Duration</span><span class="v"><%= duration_stat %></span></div>
    <div class="stat"><span class="k">Model</span><span class="v"><%= model_stat %></span></div>
    <div class="stat"><span class="k">Branch</span><span class="v"><%= branch_stat %></span></div>
  </div>
  <button class="focus-toggle deco" id="focus-toggle" aria-pressed="false">Just the conversation</button>
</header>

<div class="shell">
  <main class="timeline">
    <p class="rail-label deco">claude code</p>

    <!-- Event cards, generated from story.yaml: one anchor per event, each
         carrying its drill-in markup in a detail template (see card.html.erb). -->
    <div id="cards">
<%= cards_html %>
    </div>
  </main>

  <aside class="detail" id="sidebar">
    <div class="resizer" id="resizer"></div>
    <div class="d-head">
      <span class="kind deco" id="d-kind">Detail</span>
      <span class="d-time" id="d-time"></span>
      <button class="close" id="d-clear" title="Clear selection">◇</button>
      <button class="close" id="d-close" title="Collapse sidebar">×</button>
    </div>
    <div class="d-body" id="d-body">
      <div class="empty-detail">
        <div class="mark">❖</div>
        <p>Select an event to see its details.</p>
      </div>
    </div>
  </aside>
</div>

<button class="reopen deco" id="reopen">Details</button>

<script src="../assets/story.js"></script>
</body>
</html>
