#!/usr/bin/env ruby
# frozen_string_literal: true
#
# grab-example — copy a Claude session log into examples/ as a golden fixture,
# under a name that says what the session did. The CLI door into examples/;
# bin/importer is the browser one, and both go through the same
# ConversationStory::Import so they can't drift.
#
#   bin/grab-example <session-id> <name>
#   bin/grab-example --list [N]             # the N (default 50) newest sessions
#
# Discovery spans BOTH config dirs (~/.claude-work, ~/.claude-personal) and ALL
# projects — see Import::CONFIG_DIRS for why that isn't ~/.claude/projects and
# isn't scoped to this repo. So a session id is resolved globally: `--list` shows
# which project each one came from, and an id that somehow matches two logs is
# reported rather than guessed at.
#
# A fixture is a main log plus, if the session delegated, its subagent sidecars:
#
#   examples/<name>.jsonl
#   examples/<name>/subagents/agent-<id>.jsonl + .meta.json
#
# The parser finds the sidecars by that layout (agent ids are in the filenames),
# so this is a straight copy — no rewriting. Nothing else is needed: the tests
# glob examples/*.jsonl, and `rake build` renders whatever it finds.
#
# CAVEAT — grabbing the session you are sitting in copies a LIVE file. The
# harness appends to it continuously, so the fixture ends wherever the log
# happened to be, and everything after (including the copy itself) is missing.
# Re-run to re-snapshot; the script warns when it notices.

require "json"
require_relative "../lib/conversation_story/import"

Import = ConversationStory::Import

DEFAULT_LIST = 50

def die(msg)
  warn "grab-example: #{msg}"
  exit 1
end

# One line per session log: id, size, last write, project, and the first thing
# the human typed — enough to recognize a session without opening it. There are
# hundreds of logs on this machine, so the newest N are shown and the rest are
# counted; `bin/importer` is the place to browse them properly.
def list(limit)
  sessions = Import.sessions
  die "no session logs under #{Import::CONFIG_DIRS.join(" or ")}" if sessions.empty?

  sessions.first(limit).each do |session|
    puts format("%-38s %6s  %s  %-28s %s",
                session.id,
                "#{(session.size / 1024.0 / 1024).round(1)}M",
                session.mtime.strftime("%Y-%m-%d %H:%M"),
                session.project,
                first_prompt(session.path))
  end

  rest = sessions.size - limit
  puts "(#{rest} older session#{"s" if rest != 1} not shown — bin/grab-example --list #{sessions.size})" if rest.positive?
end

def first_prompt(log)
  File.foreach(log) do |line|
    rec = JSON.parse(line) rescue next
    next unless rec["type"] == "user"

    content = rec.dig("message", "content")
    text = content.is_a?(String) ? content : ""
    next if text.strip.empty? || text.start_with?("<")

    return text.gsub(/\s+/, " ")[0, 60]
  end
  "(no prompt found)"
end

if ARGV.first == "--list"
  list(Integer(ARGV[1] || DEFAULT_LIST))
  exit
end

session_id, name = ARGV
unless session_id && name
  warn "usage: bin/grab-example <session-id> <name>   (or --list [N])"
  exit 1
end

# Checked here as well as in Import.copy: discovery now walks hundreds of logs
# across both config dirs, and a typo'd name shouldn't wait on that to be told.
die "name should be a slug like `mode-switches`, got #{name.inspect}" unless name.match?(Import::SLUG)

begin
  session = Import.find(session_id)

  if Import.same_snapshot?(session.path, name)
    puts "examples/#{name}.jsonl is already this snapshot — nothing to do"
    exit
  end

  copied = Import.copy(session.path, name)
rescue ConversationStory::Import::Error => e
  die e.message
end

puts "examples/#{name}.jsonl  #{copied[:lines]} lines, #{(copied[:size] / 1024.0 / 1024).round(1)}M"
puts "examples/#{name}/subagents/  #{copied[:subagents]} subagent log(s)" if copied[:subagents].positive?

if ENV["CLAUDE_SESSION_ID"] == session_id || session.live?
  puts "NOTE: that log was written to seconds ago — this is a mid-session snapshot."
end

puts "next: rake build, then rake test"
