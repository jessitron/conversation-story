#!/usr/bin/env ruby
# frozen_string_literal: true
#
# render — a standalone program. Turns an intermediate story YAML into a static
# HTML page. It reads ONLY the YAML (the contract) — never the original log —
# and shares nothing with the parser at runtime.
#
#   bin/render STORY [-o OUTPUT]  # OUTPUT defaults to stdout

require "yaml"
require "fileutils"
require_relative "../lib/conversation_story/renderer"

REPO_ROOT = File.expand_path("..", __dir__)

input = nil
output = nil
args = ARGV.dup
until args.empty?
  arg = args.shift
  case arg
  when "-o", "--output" then output = args.shift
  when "-h", "--help"   then warn "usage: render STORY [-o OUTPUT]"; exit 0
  else input = arg
  end
end
abort "usage: render STORY [-o OUTPUT]" unless input

# Copy the shared, inert front-end assets next to the pages that link them.
# Pages live at out/<name>/index.html and link ../assets and ../images, so the
# site root is the parent of the page's directory. (Skipped for stdout runs.)
# Incremental copying is a later optimization; cp_r each build is fine for now.
def sync_assets(site_root)
  %w[assets images].each do |dir|
    src = File.join(REPO_ROOT, dir)
    FileUtils.cp_r(src, site_root) if File.directory?(src)
  end
end

document = YAML.safe_load_file(input)
html = ConversationStory::Renderer.new(document).to_html

if output
  FileUtils.mkdir_p(File.dirname(output))
  File.write(output, html)
  sync_assets(File.expand_path(File.join(File.dirname(output), "..")))
else
  $stdout.write(html)
end
