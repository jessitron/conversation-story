#!/usr/bin/env ruby
# frozen_string_literal: true
#
# Exercise the authoring server's write path end to end (Mount Malleable):
# start bin/serve, save a summary over HTTP, and check that the edit reached
# the sidecar file, the story.yaml AND the rendered page — then revert and
# check it all went back. Also exercises the other kind of hand edit in the
# same sidecar, a beat override, the same three places. Also checks the two
# refusals that keep a local write path from being a foot-gun: a story name
# that tries to climb out of out/, and a ref that names no event.
#
#   bin/check-edit-api [example-name] [line]
#
# With no line, it picks the story's first VISIBLE event — a hidden
# (harness-bookkeeping) event is editable in the sidecar but has no card, so
# there'd be nothing on the page to check.
#
# Runs against a TEMPORARY edits dir, so it never touches Jess's real
# summaries. It does re-run bin/parse + bin/render on the story under test,
# which rewrites out/<name>/ — with the edit reverted, byte-for-byte the same.

require "json"
require "net/http"
require "tmpdir"
require "yaml"

REPO   = File.expand_path("..", __dir__)
STORY  = ARGV[0] || "episode-8-after"
PORT   = 8123
MARKER = "check-edit-api rewrote this line"
NESTED_MARKER = "check-edit-api rewrote this subaction"

failures = []

def check(label, ok, detail = nil)
  puts(ok ? "OK    #{label}" : "FAIL  #{label}#{detail ? " — #{detail}" : ""}")
  ok
end

def put_summary(story:, ref:, summary:)
  uri = URI("http://localhost:#{PORT}/api/summary")
  req = Net::HTTP::Put.new(uri, "Content-Type" => "application/json")
  req.body = JSON.generate(story: story, ref: ref, summary: summary)
  res = Net::HTTP.start(uri.hostname, uri.port) { |http| http.request(req) }
  [res.code.to_i, JSON.parse(res.body)]
end

def put_beat(story:, ref:, beat:)
  uri = URI("http://localhost:#{PORT}/api/beat")
  req = Net::HTTP::Put.new(uri, "Content-Type" => "application/json")
  req.body = JSON.generate(story: story, ref: ref, beat: beat)
  res = Net::HTTP.start(uri.hostname, uri.port) { |http| http.request(req) }
  [res.code.to_i, JSON.parse(res.body)]
end

def beat_on_page?(ref)
  html = File.read(File.join(REPO, "out", STORY, "index.html"))
  html.match?(/id="#{Regexp.escape(ref)}"[^>]*data-beat="true"/)
end

def story_events
  YAML.safe_load_file(File.join(REPO, "out", STORY, "story.yaml"))["events"]
end

def summary_in_story(ref = REF)
  find_ref(story_events, ref)
end

# Walks nested subagent stories too: their events have cards on the page and are
# editable, but they live under the `subagent` event that spawned them rather
# than in the top-level list.
def find_ref(events, ref)
  Array(events).each do |event|
    return event if event["ref"] == ref

    found = find_ref(event.dig("subagent", "events"), ref)
    return found if found
  end
  nil
end

# The first visible event inside some subagent's own story, if this story spawned
# one — the nested-ref case, which resolves through a different code path in
# bin/serve and Edits#apply than an ordinary top-level ref.
def first_subaction
  story_events.each do |event|
    nested = event.dig("subagent", "events") || []
    found = nested.find { |e| !e["hidden"] }
    return found if found
  end
  nil
end

Dir.chdir(REPO)
abort "no such page: out/#{STORY}/index.html (run 'rake build')" unless File.exist?("out/#{STORY}/index.html")

target = if ARGV[1]
           story_events.find { |e| e["ref"] == "#{STORY}:#{ARGV[1]}" } ||
             abort("no event at line #{ARGV[1]} in #{STORY}")
         else
           story_events.find { |e| !e["hidden"] } || abort("#{STORY} has no visible events")
         end
REF = target["ref"]
# Hidden events are parsed but never drawn, so "the page shows it" can't hold.
ON_PAGE = !target["hidden"]
puts "editing #{REF} (#{target["kind"]})#{ON_PAGE ? "" : " — hidden, so no card to check"}\n\n"

Dir.mktmpdir("conversation-story-edits") do |edits_dir|
  pid = spawn(RbConfig.ruby, "bin/serve", "-p", PORT.to_s, "--edits", edits_dir,
              out: File::NULL, err: File::NULL)
  begin
    # wait for the port rather than sleeping a guessed amount
    30.times do
      break if (TCPSocket.new("localhost", PORT).close rescue nil)

      sleep 0.1
    end

    res = Net::HTTP.get_response(URI("http://localhost:#{PORT}/api/health"))
    failures << "health" unless check("GET /api/health says editing is on",
                                      res.code == "200" && JSON.parse(res.body)["editing"] == true,
                                      "#{res.code} #{res.body[0, 80]}")

    generated = summary_in_story["summary"]

    # ---- save -------------------------------------------------------------
    code, body = put_summary(story: STORY, ref: REF, summary: MARKER)
    failures << "save" unless check("PUT /api/summary accepts an edit for #{REF}",
                                    code == 200 && body["edited"] == true && body["summary"] == MARKER,
                                    "#{code} #{body}")

    event = summary_in_story
    failures << "story.yaml" unless check("story.yaml carries it, marked summary_edited",
                                          event["summary"] == MARKER && event["summary_edited"] == true,
                                          event.slice("summary", "summary_edited").to_s)

    failures << "sidecar" unless check("edits/#{STORY}.yaml holds the override",
                                       YAML.safe_load_file(File.join(edits_dir, "#{STORY}.yaml"))
                                           .dig("summaries", REF) == MARKER)

    if ON_PAGE
      page = File.read("out/#{STORY}/index.html")
      failures << "page" unless check("the rendered page shows it, marked data-edited",
                                      page.include?(MARKER) && page.include?(%(data-edited="true")))
    end

    # ---- beats -------------------------------------------------------------
    # A beat override is the other kind of hand edit in the same sidecar, and it
    # has to reach all three places a summary does: the file, story.yaml and the
    # page. Turning one OFF is the interesting direction — that's the TODO this
    # feature came from.
    beat_ref = story_events.find { |e| e["beat"] }&.fetch("ref")
    if beat_ref
      code, body = put_beat(story: STORY, ref: beat_ref, beat: false)
      failures << "beat off" unless check("PUT /api/beat turns off the beat at #{beat_ref}",
                                          code == 200 && body["beat"] == false,
                                          "#{code} #{body}")
      failures << "beat off story" unless check("story.yaml drops the beat key",
                                                !find_ref(story_events, beat_ref).key?("beat"))
      failures << "beat off page" unless check("the page drops data-beat",
                                               !beat_on_page?(beat_ref))
      failures << "beat off sidecar" unless check("the sidecar records beats: false",
                                                  YAML.safe_load_file(File.join(edits_dir, "#{STORY}.yaml"))
                                                      .dig("beats", beat_ref) == false)

      code, body = put_beat(story: STORY, ref: beat_ref, beat: nil)
      failures << "beat cleared" unless check("PUT beat:null restores the parser's default",
                                              code == 200 && body["beat"] == true,
                                              "#{code} #{body}")
      failures << "beat cleared page" unless check("the page has data-beat back",
                                                   beat_on_page?(beat_ref))
    else
      puts "SKIP  #{STORY} has no beats to toggle"
    end

    code, body = put_beat(story: STORY, ref: beat_ref || REF, beat: "yes")
    failures << "beat type" unless check("PUT /api/beat refuses a non-boolean",
                                          code == 400, "#{code} #{body}")

    # ---- refusals ---------------------------------------------------------
    code, = put_summary(story: "../../etc", ref: REF, summary: "nope")
    failures << "traversal" unless check("a story name with a path in it is refused", code == 400, code.to_s)

    code, = put_summary(story: STORY, ref: "#{STORY}:99999", summary: "nope")
    failures << "unknown ref" unless check("a ref matching no event is refused", code == 400, code.to_s)

    # ---- revert -----------------------------------------------------------
    code, body = put_summary(story: STORY, ref: REF, summary: "")
    failures << "revert" unless check("an empty summary reverts to the generated one",
                                      code == 200 && body["edited"] == false && body["summary"] == generated,
                                      "#{code} #{body}")

    failures << "sidecar removed" unless check("the emptied sidecar file is gone",
                                               !File.exist?(File.join(edits_dir, "#{STORY}.yaml")))

    if ON_PAGE
      failures << "page reverted" unless check("the page no longer shows the edit",
                                               !File.read("out/#{STORY}/index.html").include?(MARKER))
    end

    # ---- a card inside a subagent's own story ------------------------------
    if (sub = first_subaction)
      sub_ref = sub["ref"]
      code, body = put_summary(story: STORY, ref: sub_ref, summary: NESTED_MARKER)
      failures << "nested save" unless check("PUT accepts an edit for the nested #{sub_ref}",
                                             code == 200 && body["summary"] == NESTED_MARKER, "#{code} #{body}")
      failures << "nested story.yaml" unless check("the nested event carries it in story.yaml",
                                                   summary_in_story(sub_ref)["summary_edited"] == true)
      failures << "nested page" unless check("the subaction card on the page shows it",
                                             File.read("out/#{STORY}/index.html").include?(NESTED_MARKER))

      put_summary(story: STORY, ref: sub_ref, summary: "")
      failures << "nested reverted" unless check("reverting the nested edit clears the page",
                                                 !File.read("out/#{STORY}/index.html").include?(NESTED_MARKER))
    end
  ensure
    Process.kill("TERM", pid)
    Process.wait(pid)
  end
end

if failures.empty?
  puts "\nAll good: the write path works and out/#{STORY} is back to generated."
else
  warn "\n#{failures.size} failure(s): #{failures.join(", ")}"
  exit 1
end
